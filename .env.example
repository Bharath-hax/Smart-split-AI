# ── Database ──────────────────────────────────────────────────────────────
# LOCAL DEV: SQLite file (zero setup).
# PRODUCTION (Vercel): replace with your Supabase Postgres connection string.
DATABASE_URL="file:./dev.db"

# ── Session signing secret (any long random string) ─────────────────────
SESSION_SECRET=change_me_openssl_rand_hex_32

# ── Google Gemini (Google AI Studio → https://aistudio.google.com/apikey) ─
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ── Razorpay (Dashboard → Settings → API Keys → Test Mode) ──────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── App URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Notification email (automatic payment reminders via Gmail App Password) ─
# A single dedicated Gmail account sends ALL reminder emails — no user ever
# needs to connect Google. Create the account, enable 2-Step Verification,
# then generate an App Password at https://myaccount.google.com/apppasswords
# (app type: Mail) and paste the 16-character password below.
NOTIFICATION_EMAIL=your_notification_gmail@gmail.com
NOTIFICATION_EMAIL_APP_PASSWORD=your_16_char_app_password
