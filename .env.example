# ── Database ──────────────────────────────────────────────────────────────
# LOCAL DEV: SQLite file (zero setup).
# PRODUCTION (Vercel): replace with your Supabase Postgres connection string.
DATABASE_URL="file:./dev.db"

# ── Session signing secret (any long random string) ─────────────────────
SESSION_SECRET=change_me_openssl_rand_hex_32

# ── Google Gemini (Google AI Studio → https://aistudio.google.com/apikey) ─
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ── Razorpay (Dashboard → Settings → API Keys → Test Mode) ──────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── App URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (Gmail send for auto email reminders) ──────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
