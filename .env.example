# ═══════════════════════════════════════════════════════════════════════════
# SplitSettle AI — environment configuration
# Copy this file to `.env` and fill in the values you need.
# The app degrades gracefully: missing keys → fallback mode (still demoable).
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (Supabase Postgres) ──────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# For local dev with SQLite, leave as-is (schema.local.prisma is used automatically).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/splitsettle"

# ── Session signing secret ────────────────────────────────────────────────
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev_only_change_me_in_production"

# ── Google Gemini (primary AI for OCR + chat + insights) ──────────────────
# Get a free key at: https://aistudio.google.com/apikey
# Leave empty → OCR falls back to manual entry + keyword categories.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ── OpenAI (optional fallback for AI features) ────────────────────────────
# Only used if USE_OPENAI_FALLBACK=true AND GEMINI_API_KEY is empty.
# Get a key at: https://platform.openai.com/api-keys
USE_OPENAI_FALLBACK="false"
OPENAI_API_KEY=""

# ── Razorpay (test/sandbox mode for payment links) ────────────────────────
# Get test keys at: https://dashboard.razorpay.com/app/keys
# Leave empty → mock payment links (demo mode, no real money moves).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Twilio WhatsApp (optional auto-reminders) ─────────────────────────────
# Sign up at: https://console.twilio.com
# Sandbox number looks like: whatsapp:+14155238886
# Leave empty → in-app copyable reminder messages (fallback).
# ⚠️ Each recipient must send your Twilio sandbox a one-time "join <code>" message
#   before they can receive automated messages (WhatsApp platform requirement).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# ── App URL (for payment-link callbacks) ──────────────────────────────────
# Vercel injects VERCEL_URL automatically. For local dev:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
